[Unit]
Description=aifactory worker %i (runs jobs only, so more tasks run at once)
# Not ordered after aifactory.service: a restart of every process would then stop the workers first and start
# them only once the main process drained its own run and came back, and the factory ran nothing meanwhile.
# The workers need Postgres, which run-server.sh waits for, and migrations, which the deploy applies first.

[Service]
WorkingDirectory=@ROOT@
Environment=PATH=@NODE_BIN@:/usr/local/bin:/usr/bin:/bin
Environment=FACTORY_WORKER_ONLY=1
Environment=PORT=300%i
ExecStart=@ROOT@/scripts/run-server.sh
Restart=always
RestartSec=5
# A stop signals only theokit, which stops taking jobs and waits for the run in progress (up to four hours,
# see src/server/factory/drain.ts); the agent's commands keep running meanwhile. Past this, systemd kills all.
KillMode=mixed
TimeoutStopSec=243min

[Install]
WantedBy=default.target
