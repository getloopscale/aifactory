[Unit]
Description=aifactory server (issues to verified pull requests)
After=network-online.target

[Service]
WorkingDirectory=@ROOT@
Environment=PATH=@NODE_BIN@:/usr/local/bin:/usr/bin:/bin
# The main process takes no job, so a restart never waits for a run and the crons stop only for seconds.
Environment=FACTORY_SERVER_ONLY=1
ExecStart=@ROOT@/scripts/run-server.sh
Restart=always
RestartSec=5
# A stop signals only theokit, which closes storage and exits. It holds no run, so two minutes is plenty.
KillMode=mixed
TimeoutStopSec=2min

[Install]
WantedBy=default.target
