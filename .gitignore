# dependencies
node_modules/
.pnp
.pnp.*

# loopzero
# `.loopzero/` holds the agent context you write AND what `loopzero build` generates. The context
# (LOOPZERO.md, rules, personalities, skills, agents, commands, hooks.json) is versioned; build
# output, agent memory, local overrides and MCP tokens stay out (usetheokit/theokit#1075).
.loopzero/*
!.loopzero/LOOPZERO.md
!.loopzero/rules/
!.loopzero/personalities/
!.loopzero/skills/
!.loopzero/agents/
!.loopzero/commands/
!.loopzero/hooks.json
dist/

# credentials written by scripts/github-app-setup.mjs
.secrets/

# vercel (project link written by `vercel link`)
.vercel/

# env files
.env
.env.local
.env.*.local

# testing
coverage/

# debug
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# misc
.DS_Store
*.pem
*.tsbuildinfo

# framework-written app data — conversation transcripts (.data/agent-sessions/**/*.jsonl)
# and the local SQLite DB both live here. This said `data/`, without the dot, and
# matched nothing the framework writes: every prompt, answer, tool input and tool
# result went into version control on the first commit after the first run (#395).
.data/

# editors
.vscode/
.idea/
*.swp
*.swo
.vercel
.env*
coverage/
.stryker-tmp/
reports/

# What the backlog feeder records about its run
.backlog-feed/

# the mirror of the knowledge repository the factory keeps on this host
.state/

# runs of the evaluation suite (ADR 0008); the baseline is in evals/
.evals/

# the desktop client's installers
desktop/dist/
