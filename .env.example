# Postgres for the factory's state. `docker compose up -d` serves this one locally.
DATABASE_URL=postgres://factory:factory@localhost:54329/factory

# Secret configured on the GitHub webhook (Settings > Webhooks). Without it /api/webhooks/github answers 503.
GITHUB_WEBHOOK_SECRET=

# The factory's GitHub App. `node scripts/github-app-setup.mjs` registers it and writes these to
# .env.<name>, with the private key in .secrets/; move the lines into .env.local. GITHUB_WEBHOOK_SECRET
# above is the app's.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=
# The id of the user <slug>[bot]: commits signed with its email gain no co-author on a squash.
GITHUB_APP_BOT_USER_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# How Claude Code pays. Held by the factory and attached by the sandbox firewall; the agent never
# sees it. Set one: a Console API key, or the one-year subscription token from `claude setup-token`.
# With both set the subscription is used; FACTORY_CLAUDE_AUTH=api-key|subscription overrides.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
FACTORY_CLAUDE_AUTH=

# Which agent runs a task when the issue has no `harness:<name>` label: claude-code (default) or codex.
# The Agents page of the panel changes this (and the planner and the reviewer) without a restart, and what
# is chosen there wins over these. FACTORY_PLANNER and FACTORY_REVIEWER default to the builder's agent.
FACTORY_HARNESS=
# FACTORY_PLANNER=
# FACTORY_REVIEWER=
# The model and the effort of a role, kept with the agent they are for ("codex:gpt-6.1-sol"). The Agents page sets
# these too. FACTORY_MODEL_BUILDER, FACTORY_EFFORT_BUILDER, and the same for PLANNER and REVIEWER.

# How Codex pays. An API key, or the factory's own ChatGPT login: run
# `CODEX_HOME=~/.codex-factory-1 codex login --device-auth` (not your everyday ~/.codex, because the
# refresh token rotates and two users of one login invalidate each other).
# FACTORY_CODEX_AUTH=api-key|subscription picks when both exist; FACTORY_CODEX_HOME moves the login.
OPENAI_API_KEY=
FACTORY_CODEX_AUTH=
FACTORY_CODEX_HOME=

# Vercel Sandbox, with a token that does not expire in 12 hours (team and project in .vercel/project.json).
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Vercel Sandbox: `vercel link` then `vercel env pull .env.local` writes VERCEL_OIDC_TOKEN (12 h).
VERCEL_OIDC_TOKEN=

# The panel (http://localhost:3000). One owner, who signs in with FACTORY_PANEL_TOKEN; the session
# cookie is encrypted with FACTORY_PANEL_SECRET. Both must be at least 32 characters, for example
# `openssl rand -base64 36`. Without them the panel refuses everyone.
FACTORY_PANEL_TOKEN=
FACTORY_PANEL_SECRET=

# What the factory does with a release (merging a delivered pull request and publishing a version).
# It always makes a pre-release. manual (default): only a person releases, from the panel.
# trial: records what an agent would have released. auto: releases a commit with green checks and an
# approving review.
FACTORY_RELEASE_MODE=

# The most issues the promotion watch opens in one repository per pass, for checks that failed on a
# promotion pull request. Three when empty; 0 keeps the reruns and opens nothing.
FACTORY_PROMOTION_ISSUES_PER_PASS=

# The writing assistant under every text box in the panel. It calls the model provider directly with this
# key (a subscription token cannot be used for it). FACTORY_ASSIST_MODEL changes the model, with the key of
# its provider (anthropic/ needs ANTHROPIC_API_KEY, openrouter/ needs OPENROUTER_API_KEY).
# FACTORY_ASSIST_MODEL=anthropic/claude-sonnet-4-6

# The assistant in the panel's chat. OpenRouter needs OPENROUTER_API_KEY; the ChatGPT option uses the
# subscription connected from the chat itself (stored in ~/.theokit/auth.json), so it needs no key here.
# OPENROUTER_API_KEY=
# FACTORY_CHAT_MODEL=openrouter/google/gemini-2.5-flash
# FACTORY_CHAT_CODEX_MODEL=openai-chatgpt/gpt-5.4
# The guide of each page (Board, Plans, Repositories, Inbox, Health, Setup). It must look at the live data
# before it answers, which the cheapest models did not do, so the default is a little larger.
# FACTORY_GUIDE_MODEL=openrouter/openai/gpt-4.1-mini

# The coordinator (ADR 0011): off, trial (the default: decide and record, apply nothing) or auto. The model
# it drafts a scope decision with, through OpenRouter's key. The date the four weeks before which are the
# baseline the weekly comparison of the indicators reads (YYYY-MM-DD), usually the day auto was turned on.
# FACTORY_COORDINATOR_MODE=trial
# Review patterns: a class of defect the reviewer blocked three tasks of a repository with in 30 days becomes a
# note for that project: off, trial (the default: group and record, write no note) or auto.
# FACTORY_REVIEW_PATTERN_MODE=trial
# A red promotion of the integration branch stops the line of its repository (`line/`): off, trial (the
# default: log what it would do and file one issue per check as before) or auto (one fix issue for every failure,
# every other run and integration of the repository held until the promotion is green).
# FACTORY_LINE_STOP_MODE=trial
# FACTORY_COORDINATOR_MODEL=openrouter/openai/gpt-4.1-mini
# FACTORY_BASELINE_FROM=

# The scheduler (the schedule cron, every two minutes) has two steps, each off, trial (the default: decide and
# record, change no job, task or issue) or auto. FACTORY_SCHEDULER_MODE is the order: in auto it orders the queued
# runs by priority:N label, bug, what other queued issues are blocked by, and age. FACTORY_READINESS_MODE is the
# readiness judge: in auto it holds back a newly queued issue that is not ready to build, asking its question on the
# issue. The judge runs on FACTORY_COORDINATOR_MODEL.
# FACTORY_SCHEDULER_MODE=trial
# FACTORY_READINESS_MODE=trial

# Where sandboxes run: vercel (default); docker, containers on this machine behind a proxy that enforces
# the domain allowlist and attaches credentials outside the container (FACTORY_SANDBOX_MEMORY, 5g, and
# FACTORY_SANDBOX_CPUS, 3, size each one); or e2b, E2B's cloud sandboxes, which need E2B_API_KEY and the
# template from `node --env-file=.env.local scripts/build-e2b-template.mts`. E2B's free plan stops a sandbox
# after an hour, and a run plans for that; E2B_MAX_SESSION_MS raises it on a plan that allows more.
# FACTORY_SANDBOX=docker
# E2B_API_KEY=
# E2B_MAX_SESSION_MS=3600000

# The address of the panel as the owner reaches it (never the tunnel). When set, the pull request body links the
# files a check wrote for the checked commit; the links need an owner session. Unset: the files are only named.
# FACTORY_PANEL_URL=http://localhost:3000

# Linear (host only: never given to a sandbox). The key must belong to a dedicated user or app of the workspace:
# the factory is whoever the key is, and a personal key makes that person's own answers read as the factory's.
LINEAR_API_KEY=
LINEAR_WEBHOOK_SECRET=

# Looptrace (host or tailnet only, never through the tunnel: the spans hold private code). The complete OTLP traces URL,
# /v1/traces included. Unset: no pass is exported and no job is queued. The token is optional (a bearer token).
# FACTORY_TRACE_ENDPOINT=http://localhost:4318/v1/traces
# FACTORY_TRACE_TOKEN=
# FACTORY_TRACE_UI_URL=http://localhost:3000   # where the History page links a trace in Looptrace
