{
  "name": "aifactory",
  "version": "0.2.0",
  "private": true,
  "description": "A software factory that turns GitHub issues into verified pull requests with coding agents running in cloud sandboxes.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "loopzero dev",
    "build": "loopzero build",
    "start": "loopzero start",
    "preview": "loopzero preview",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "coverage": "vitest run --project unit --project integration --no-file-parallelism --coverage",
    "trace:backfill": "node --env-file=.env.local scripts/trace-backfill.mjs",
    "crap": "node scripts/crap.mjs",
    "dup": "jscpd",
    "mutation": "stryker run",
    "quality": "pnpm coverage && pnpm crap && pnpm dup && pnpm mutation",
    "test:e2e": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --project e2e --no-file-parallelism",
    "evals": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --project evals",
    "evals:cases": "EVALS_MODE=cases node --env-file=.env.local node_modules/vitest/vitest.mjs run --project evals",
    "evals:check": "EVALS_MODE=check node --env-file=.env.local node_modules/vitest/vitest.mjs run --project evals",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "push:keys": "node scripts/push-keys.mjs"
  },
  "dependencies": {
    "@getloopscale/loopzero": "^0.1.0",
    "@getloopscale/loopzero-agents": "^0.1.0",
    "@getloopscale/loopzero-sdk": "^0.1.0",
    "@getloopscale/loopzero-ui": "^0.1.0",
    "@getloopscale/ui": "^0.38.0",
    "@vercel/sandbox": "^3.9.1",
    "@xterm/xterm": "^5.5.0",
    "drizzle-orm": "0.45.4",
    "e2b": "2.63.0",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "lucide-react": "0.471.2",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-hast": "^13.2.2",
    "micromark-extension-gfm": "^3.0.0",
    "pg": "8.23.1",
    "proper-lockfile": "^4.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "web-push": "^4.0.0",
    "yaml": "2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "3.2.7",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jscpd": "^5.4.2",
    "jsdom": "^25.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
