{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A packaged client of the aifactory panel with a tray that shows what waits for the owner.",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist --out-extension:.js=.cjs",
    "start": "pnpm build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "pnpm build && electron-builder"
  },
  "build": {
    "appId": "dev.aifactory.desktop",
    "productName": "aifactory",
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "directories": {
      "output": "dist/installer"
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
